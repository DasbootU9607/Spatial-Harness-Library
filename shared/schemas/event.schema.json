{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "$id": "https://dasbootu9607.github.io/Spatial-Harness-Library/shared/schemas/event.schema.json",
  "required": [
    "id",
    "seq",
    "runId",
    "at",
    "recordedAt",
    "type",
    "actor",
    "origin",
    "actionId",
    "candidateId",
    "details",
    "evidenceRefs"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^e[0-9]{6,}$"
    },
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "runId": {
      "type": "string"
    },
    "at": {
      "type": [
        "string",
        "null"
      ]
    },
    "recordedAt": {
      "type": "string"
    },
    "type": {
      "type": "string"
    },
    "actor": {
      "type": "string"
    },
    "origin": {
      "enum": [
        "observed",
        "agent_statement",
        "historical"
      ]
    },
    "actionId": {
      "type": [
        "string",
        "null"
      ]
    },
    "candidateId": {
      "type": [
        "string",
        "null"
      ]
    },
    "details": {
      "type": "object"
    },
    "evidenceRefs": {
      "type": "array"
    }
  },
  "additionalProperties": false
}
