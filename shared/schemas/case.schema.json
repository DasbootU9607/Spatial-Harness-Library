{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "$id": "https://dasbootu9607.github.io/Spatial-Harness-Library/shared/schemas/case.schema.json",
  "required": [
    "schemaVersion",
    "id",
    "harnessId",
    "skillIds",
    "sourceKind",
    "sourceCaseIds",
    "title",
    "contentSha256",
    "taskArtifact",
    "verification",
    "build",
    "process"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "contentSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sourceKind": {
      "enum": [
        "official",
        "agent-authored",
        "demonstration"
      ]
    },
    "verification": {
      "type": "object",
      "required": [
        "verdict",
        "candidateId",
        "fingerprints",
        "report"
      ],
      "properties": {
        "verdict": {
          "const": "passed"
        }
      }
    }
  }
}
