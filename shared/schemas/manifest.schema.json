{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "$id": "https://dasbootu9607.github.io/Spatial-Harness-Library/shared/schemas/manifest.schema.json",
  "required": [
    "schemaVersion",
    "id",
    "title",
    "task",
    "runKind",
    "harness",
    "status",
    "createdAt",
    "finishedAt",
    "configuration",
    "limitations",
    "captureGaps"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "runKind": {
      "enum": [
        "skill-development",
        "task-generation"
      ]
    },
    "finishedAt": {
      "type": [
        "string",
        "null"
      ]
    },
    "limitations": {
      "type": "array"
    },
    "captureGaps": {
      "type": "array"
    }
  }
}
